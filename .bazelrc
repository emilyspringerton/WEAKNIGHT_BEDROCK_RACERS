# WEAKNIGHT_BEDROCK_RACERS' Bazel config. Same global-flags-not-per-target shape
# PARENA/ECOWAR's own .bazelrc already establish -- every cc_library/cc_binary gets the same
# discipline .github/workflows/ci.yml's own gcc invocations hold themselves to, without repeating
# it in every BUILD.bazel file.
build --conlyopt=-std=c99
build --copt=-D_DEFAULT_SOURCE
build --copt=-O2
build --copt=-Wall
build --copt=-Wextra
